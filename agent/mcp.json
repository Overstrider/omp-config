{
  "$schema": "https://raw.githubusercontent.com/can1357/oh-my-pi/main/packages/coding-agent/src/config/mcp-schema.json",
  "mcpServers": {
    "codebase-memory-mcp": {
      "type": "stdio",
      "command": "codebase-memory-mcp",
      "args": [],
      "enabled": true,
      "timeout": 120000
    },
    "graphify": {
      "type": "stdio",
      "command": "graphify-mcp",
      "args": [
        "graphify-out/graph.json"
      ],
      "enabled": true,
      "timeout": 120000
    }
  }
}
